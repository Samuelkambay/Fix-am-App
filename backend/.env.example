NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://fixam:fixam@localhost:5432/fixam
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:4000

# SMS: "console" logs messages to the sms_outbox table and stdout.
SMS_PROVIDER=console

# Mobile money gateways. "sandbox" simulates all operators end to end.
# Set PAYMENT_MODE=live and fill in the operator credentials you receive at merchant onboarding.
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET_SANDBOX=sandbox-webhook-secret

ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

AFRIMONEY_BASE_URL=
AFRIMONEY_API_KEY=
AFRIMONEY_MERCHANT_ID=
AFRIMONEY_WEBHOOK_SECRET=

QMONEY_BASE_URL=
QMONEY_API_KEY=
QMONEY_MERCHANT_ID=
QMONEY_WEBHOOK_SECRET=

MONIME_BASE_URL=
MONIME_API_KEY=
MONIME_SPACE_ID=
MONIME_WEBHOOK_SECRET=

# USSD aggregator: requests must carry this in the x-ussd-secret header (or ?key=). Required in production.
USSD_SHARED_SECRET=
# Sandbox: seconds before a pending sandbox payment auto-approves when polled.
SANDBOX_AUTO_APPROVE_SEC=8
UPLOAD_DIR=uploads
