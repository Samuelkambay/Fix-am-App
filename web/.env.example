# Base URL of the FixAm API as seen by the browser. Default: /api/v1 (proxied by Vite to the backend).
# Set an absolute URL to call a remote API directly, e.g. https://api.fixam.sl/api/v1
VITE_API_URL=/api/v1

# Where the Vite dev/preview server proxies /api to (not exposed to the browser).
API_PROXY_TARGET=http://localhost:4000
